<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Location Status Helper" android:textAppearance="?attr/textAppearanceHeadlineSmall" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="A transparent utility that keeps location actively used only while you choose to run it. Android controls its native privacy indicator." />
        <Switch android:id="@+id/enabledSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Enable Location Service" />
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textIsSelectable="true" />
        <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Enable Location Service" />
        <Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Stop Location Service" />
        <Button android:id="@+id/locationSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open Location Settings" />
        <Button android:id="@+id/permissionSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open App Permission Settings" />
        <Switch android:id="@+id/launcherSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Launcher icon visible (required for reliable recovery)" />
        <Button android:id="@+id/enableAdminButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Enable Optional Device Admin" />
        <Button android:id="@+id/disableAdminButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Disable Device Admin" />
        <Button android:id="@+id/backgroundGuideButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Background Operation Guide" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Privacy and recovery\nLocation is received locally and discarded; it is not uploaded or stored. The persistent notification includes Stop. If Android or Realme blocks automatic recovery, use the notification Resume action or Android Settings → Apps → Location Status Helper. A secret dial code such as #1234# is not a reliable API for ordinary third-party apps, so this app does not intercept carrier/USSD codes." android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
