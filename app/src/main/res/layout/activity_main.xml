<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Location Status Helper" android:textAppearance="?attr/textAppearanceHeadlineSmall" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="A transparent utility that keeps location actively used while you choose to run it. Android controls its native privacy indicator." />
        <Switch android:id="@+id/enabledSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Service enabled by me" />
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textIsSelectable="true" />
        <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Start Location Service" />
        <Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Stop Location Service" />
        <Button android:id="@+id/locationSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open Android Location Settings" />
        <Button android:id="@+id/permissionSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open App Permission Settings" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Battery guidance\nFor reliable operation, allow this app to run in the background and exclude it from battery optimization if your device offers that choice. Realme may also require Auto-launch and unrestricted battery settings. These settings can increase battery use." android:textIsSelectable="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Privacy\nWhen enabled, the foreground service requests periodic location updates from Android. Location is not uploaded, stored, or shared by this app. Stop the service or revoke permission at any time. A persistent notification is always shown while active." android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
